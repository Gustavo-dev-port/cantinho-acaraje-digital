# Copie este arquivo para ".env.local" (o Vite carrega ".env.local" automaticamente).
#
# Todas as variáveis abaixo são PÚBLICAS por design (a "anon key" do
# Supabase e o company_id são feitos pra ficar no navegador) — não são
# segredos, podem ficar neste arquivo e até serem commitadas se precisar.
#
# A chave da IA (Gemini) NÃO entra aqui — ela fica só nos Secrets da Edge
# Function "garcom-ai", no painel do Supabase (Project Settings > Edge
# Functions > Secrets, variável GEMINI_API_KEY).

VITE_SUPABASE_URL=https://gbiftkfjoeziqgrahtnj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdiaWZ0a2Zqb2V6aXFncmFodG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4MTQ4MTMsImV4cCI6MjEwMjM5MDgxM30.39Ydh39M6oU4Tw9YJMc-fzUYzS8_wXlOzrZ3pEePG6M

# id da linha do Cantinho do Acarajé na tabela companies — é o que filtra
# quais produtos o cardápio digital busca (ver docs/migracao-cardapio-supabase/).
VITE_SUPABASE_COMPANY_ID=9467ade6-e25a-4aee-a6c8-03be31af4dda
